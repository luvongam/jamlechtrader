# ── Stage: base ──────────────────────────────────────────────────
FROM python:3.12-slim AS base

WORKDIR /app

# Copy project files
COPY pyproject.toml .
COPY jamlechtrader/ jamlechtrader/
COPY tests/ tests/
COPY main.py .

# Install package (editable) with dev dependencies
RUN pip install --no-cache-dir -e ".[dev]"

# Create mount-point directories
RUN mkdir -p /app/data_cache /app/logs /app/output

ENV DATA_DIR=/app/data_cache

# ── Stage: test ──────────────────────────────────────────────────
FROM base AS test

CMD ["pytest", "tests/", "-v"]

# ── Stage: app (default) ────────────────────────────────────────
FROM base AS app

ENTRYPOINT ["jamlechtrader"]
CMD ["--help"]
